# ==============================================================================
# MEMORA AI — Frontend Environment Variables (Vite)
# ==============================================================================

# Backend API base URL
# Local development:
VITE_API_BASE_URL=http://localhost:8000

# Production deployment (Vercel serverless or custom domain):
# For unified deployment (frontend + API on same Vercel project), leave blank:
# VITE_API_BASE_URL=
# For separate frontend/backend Vercel projects, specify your backend Vercel deployment URL:
# VITE_API_BASE_URL=https://memora-ai-api.vercel.app
