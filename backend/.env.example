NEBIUS_API_KEY=replace_with_your_api_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
FRONTEND_ORIGIN=http://localhost:5173

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.aws-us-east-2.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xyz.aws-us-east-2.neon.tech/neondb?sslmode=require

# Day 4: Semantic and Hybrid Retrieval
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSION=1024
EMBEDDING_API_BASE_URL=https://api.tokenfactory.nebius.com/v1
SIMILARITY_THRESHOLD=0.58
KEYWORD_WEIGHT=0.50
SEMANTIC_WEIGHT=0.50
HYBRID_LIMIT=5

# Day 7: Environment & Production Safety Gates
ENVIRONMENT=development
ENABLE_EVALUATION_ENDPOINT=false

# Day 7.2: Genuine Authentication & Worker Lease Configuration
AUTH_SECRET_KEY=replace_with_a_secure_random_32_character_string
API_AUTH_TOKENS=
WORKER_LEASE_MINUTES=5
WORKER_LEASE_SECONDS=60
CRON_SECRET=replace_with_secure_random_string_for_cron_auth

# Vercel Serverless & Connection Pool Tuning
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=3

